{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Add OBD2 adapter",
        "description": "⚠️ This integration is under development and is used entirely at your own risk; the author accepts no liability for any direct or indirect damage (see README). Each adapter belongs to one vehicle. Add the integration again for every additional adapter/vehicle.",
        "menu_options": {
          "pick_bluetooth": "Bluetooth LE adapter (e.g. Vgate iCar Pro 2S)",
          "tcp": "Wi-Fi adapter (TCP)",
          "simulator": "Simulator (test without vehicle)"
        }
      },
      "pick_bluetooth": {
        "title": "Choose Bluetooth adapter",
        "description": "Devices marked ★ are recognised OBD2 adapters. The Vgate iCar Pro 2S advertises as 'IOS-Vlink'. Already configured adapters are hidden. Turn the ignition on to wake the adapter if it is missing.",
        "data": {
          "address": "Adapter"
        }
      },
      "bluetooth_confirm": {
        "title": "OBD2 adapter found",
        "description": "Set up {name} ({model})?"
      },
      "tcp": {
        "title": "Wi-Fi OBD2 adapter",
        "data": {
          "host": "Host",
          "port": "Port"
        }
      },
      "simulator": {
        "title": "Simulator",
        "data": {
          "sim_vehicle": "Simulated vehicle"
        }
      },
      "vehicle": {
        "title": "Vehicle",
        "description": "The connection test only checks the adapter, not the vehicle. With 'Automatic' the profile is chosen from the VIN; generic OBD2 always works.",
        "data": {
          "vehicle_name": "Vehicle name",
          "profile": "Vehicle profile",
          "mode": "Read mode",
          "bluetooth_source": "Bluetooth adapter / proxy",
          "skip_connection_test": "Skip connection test"
        },
        "data_description": {
          "bluetooth_source": "'Automatic' lets Home Assistant pick the adapter or ESPHome proxy with the best signal. Choose a specific one to always connect through it (the value behind it is the signal strength to the dongle)."
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot connect to the adapter. Is it awake and in range (and not connected to a phone)?",
      "not_seen_by_adapter": "The selected Bluetooth adapter/proxy does not see this dongle at the moment. Choose another one or 'Automatic'.",
      "not_elm327": "The device does not answer like an ELM327 adapter.",
      "unknown": "Unexpected error"
    },
    "abort": {
      "already_configured": "This adapter is already configured.",
      "already_in_progress": "Setup is already in progress.",
      "no_devices_found": "No new Bluetooth devices found. Wake the adapter (ignition on) and try again."
